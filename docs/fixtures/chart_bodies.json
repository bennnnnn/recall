  {"name": "a pre-binned histogram with a tooltip format Vega cannot read", "body": "{\"$schema\":\"https://vega.github.io/schema/vega-lite/v5.json\",\"data\":{\"values\":[{\"score\":55},{\"score\":62},{\"score\":68},{\"score\":70},{\"score\":71},{\"score\":75},{\"score\":78},{\"score\":80},{\"score\":82},{\"score\":85},{\"score\":88},{\"score\":90},{\"score\":95}]},\"transform\":[{\"bin\":true,\"field\":\"score\",\"as\":[\"score_start\",\"score_end\"]},{\"aggregate\":[{\"op\":\"count\",\"as\":\"frequency\"}],\"groupby\":[\"score_start\",\"score_end\"]}],\"mark\":\"bar\",\"encoding\":{\"x\":{\"field\":\"score_start\",\"type\":\"quantitative\",\"bin\":\"binned\"},\"y\":{\"field\":\"frequency\",\"type\":\"quantitative\"},\"tooltip\":[{\"field\":\"score_start\",\"type\":\"quantitative\",\"format\":\"[datum.scoreStart, datum.scoreEnd)\"}]}}", "draws": true},
