  {"name": "a stacked bar with a template literal in an unused calculation", "body": "{\"$schema\":\"https://vega.github.io/schema/vega-lite/v5.json\",\"data\":{\"values\":[{\"grade\":1,\"male\":20,\"female\":22},{\"grade\":2,\"male\":18,\"female\":25},{\"grade\":3,\"male\":24,\"female\":19}],\"format\":{\"type\":\"json\"}},\"transform\":[{\"fold\":[\"male\",\"female\"],\"as\":[\"gender\",\"count\"]},{\"calculate\":\"`Grade ${datum.grade} - ${datum.gender}`\",\"as\":\"label\"}],\"mark\":\"bar\",\"encoding\":{\"x\":{\"field\":\"grade\",\"type\":\"nominal\",\"sort\":null,\"title\":\"Grade\"},\"y\":{\"aggregate\":\"sum\",\"field\":\"count\",\"type\":\"quantitative\",\"title\":\"Number of Students\"},\"color\":{\"field\":\"gender\",\"type\":\"nominal\",\"title\":\"Gender\"}}}", "draws": true},
