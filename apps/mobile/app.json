{
  "expo": {
    "name": "Recall",
    "slug": "recall",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "recall",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.recall.app",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Recall sends reminders for your to-dos.",
        "NSLocationWhenInUseUsageDescription": "Recall uses your location for local time and to answer where you are.",
        "NSPhotoLibraryUsageDescription": "Recall needs access to your photos so you can attach images in chat.",
        "NSPhotoLibraryAddUsageDescription": "Recall saves generated and chat images to your photo library when you tap Download.",
        "NSCameraUsageDescription": "Recall uses the camera so you can take photos to attach in chat and scan math problems from your notes or worksheets.",
        "NSMicrophoneUsageDescription": "Recall uses the microphone so you can dictate messages and talk with Recall in Live Talk.",
        "NSMotionUsageDescription": "Recall does not use motion or fitness data and never asks for it.",
        "LSApplicationQueriesSchemes": [
          "googlegmail",
          "gmail",
          "mailto",
          "https"
        ]
      }
    },
    "android": {
      "package": "com.recall.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#4F56E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#0F0F10"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4F56E5",
          "sounds": [
            "./assets/audio/recall_notify.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Recall uses your location for local time and to answer where you are.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "Recall does not use motion or fitness data and never asks for it."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Recall needs access to your photos so you can attach images in chat.",
          "cameraPermission": "Recall uses the camera so you can take photos to attach in chat and scan math problems from your notes or worksheets.",
          "microphonePermission": "Recall uses the microphone so you can dictate messages and talk with Recall in Live Talk."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Recall needs access to your photos so you can attach images in chat.",
          "savePhotosPermission": "Recall saves generated and chat images to your photo library when you tap Download.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "KaTeX_Main",
                "fontDefinitions": [
                  { "path": "./assets/fonts/KaTeX_Main-Regular.ttf", "weight": 400 }
                ]
              },
              {
                "fontFamily": "KaTeX_MathItalic",
                "fontDefinitions": [
                  { "path": "./assets/fonts/KaTeX_Math-Italic.ttf", "weight": 400 }
                ]
              },
              {
                "fontFamily": "KaTeX_AMS",
                "fontDefinitions": [
                  { "path": "./assets/fonts/KaTeX_AMS-Regular.ttf", "weight": 400 }
                ]
              },
              {
                "fontFamily": "SpaceMono",
                "fontDefinitions": [
                  { "path": "./assets/fonts/SpaceMono-Regular.ttf", "weight": 400 }
                ]
              },
              {
                "fontFamily": "SourceSans3",
                "fontDefinitions": [
                  { "path": "./node_modules/@expo-google-fonts/source-sans-3/400Regular/SourceSans3_400Regular.ttf", "weight": 400 }
                ]
              },
              {
                "fontFamily": "SourceSans3-Medium",
                "fontDefinitions": [
                  { "path": "./node_modules/@expo-google-fonts/source-sans-3/500Medium/SourceSans3_500Medium.ttf", "weight": 400 }
                ]
              },
              {
                "fontFamily": "SourceSans3-Semibold",
                "fontDefinitions": [
                  { "path": "./node_modules/@expo-google-fonts/source-sans-3/600SemiBold/SourceSans3_600SemiBold.ttf", "weight": 400 }
                ]
              },
              {
                "fontFamily": "SourceSans3-Bold",
                "fontDefinitions": [
                  { "path": "./node_modules/@expo-google-fonts/source-sans-3/700Bold/SourceSans3_700Bold.ttf", "weight": 400 }
                ]
              }
            ]
          }
        }
      ],
      [
        "react-native-vision-camera-mlkit",
        {
          "textRecognition": true,
          "textRecognitionChinese": false,
          "textRecognitionDevanagari": false,
          "textRecognitionJapanese": false,
          "textRecognitionKorean": false,
          "barcodeScanning": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Recall uses the microphone so you can dictate messages and talk with Recall in Live Talk.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Recall uses the microphone so you can dictate messages and talk with Recall in Live Talk.",
          "cameraPermission": "Recall uses the camera so you can take photos to attach in chat and scan math problems from your notes or worksheets."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
