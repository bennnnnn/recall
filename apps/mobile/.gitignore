# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
# Vendored image-size ships its built CJS under dist/ (Metro override).
!vendor/
!vendor/image-size/
!vendor/image-size/dist/
!vendor/image-size/dist/**
# So does vendored deepmerge (the GHSA-gcqx-w48m-w2h4 fix), for @expo/config and jest-config.
!vendor/deepmerge/
!vendor/deepmerge/dist/
!vendor/deepmerge/dist/**
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Reassure render benchmarks (pnpm perf)
.reassure/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Built on install from node_modules (scripts/generate-licenses.mjs)
lib/licenses.generated.json
