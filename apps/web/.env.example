# API base URL. Local dev points at the FastAPI on port 8000.
# Use your machine's LAN IP (not localhost) if the API is on another host.
VITE_API_URL=http://localhost:8000

# Google Identity Services web client ID — same as the mobile app's
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID / API GOOGLE_CLIENT_ID. Also add
# http://localhost:5173 to the Google OAuth "Authorized JavaScript origins"
# in the Google Cloud console for local sign-in to work.
VITE_GOOGLE_CLIENT_ID=
